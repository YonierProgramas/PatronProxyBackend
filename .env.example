# Copy values into the process environment; Spring does not automatically load .env.
SPRING_PROFILES_ACTIVE=local
INVENTORY_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
CORS_ALLOWED_ORIGINS=http://localhost:5173
INTERNAL_TIMEOUT_MS=3000
SIMULATION_COOLDOWN_MS=10000
# Production only: JDBC URL and private credentials supplied by provider
# SPRING_DATASOURCE_URL=jdbc:postgresql://private-host:5432/audit
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# Render Blueprint derives HTTP URLs from provider host:port references.
# Direct *_SERVICE_URL values take precedence if explicitly supplied.
# INVENTORY_SERVICE_HOSTPORT=
# ORDER_SERVICE_HOSTPORT=
# PAYMENT_SERVICE_HOSTPORT=
# PGHOST=
# PGPORT=5432
# PGDATABASE=
# DB_MAX_POOL_SIZE=5
# PORT is injected by Render; the Blueprint explicitly uses 10000 per container.
