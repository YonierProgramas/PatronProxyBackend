# Copy values into the process environment; Spring does not automatically load .env.
SPRING_PROFILES_ACTIVE=local
INVENTORY_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
CORS_ALLOWED_ORIGINS=http://localhost:5173
INTERNAL_TIMEOUT_MS=3000
SIMULATION_COOLDOWN_MS=10000
# Production only: JDBC URL and private credentials supplied by provider
# SPRING_DATASOURCE_URL=jdbc:postgresql://private-host:5432/audit
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
