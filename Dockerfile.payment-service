FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml ./
COPY shared-contracts shared-contracts
COPY inventory-service inventory-service
COPY order-service order-service
COPY payment-service payment-service
COPY monitor-api monitor-api
RUN mvn -B -pl payment-service -am package -DskipTests
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/payment-service/target/payment-service-1.0.0.jar app.jar
USER 10001
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65 -XX:ActiveProcessorCount=2"
ENTRYPOINT ["java","-jar","app.jar"]
